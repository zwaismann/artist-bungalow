# Business book (local / vercel dev only)
# Copy to .env.local. Never commit real secrets.

# Recommended signing secret for session cookies.
BUSINESS_BOOK_SESSION_SECRET=

# One-time / first enroll. Required to create a passkey unless using the backup password.
BUSINESS_BOOK_SETUP_TOKEN=

# Fallback only. Used if passkey is unavailable, and can also unlock first-time enroll.
BUSINESS_BOOK_PASSWORD=

# Optional. JSON array of registered passkey public keys for other browsers after enroll.
# BUSINESS_BOOK_WEBAUTHN_CREDENTIALS=

# Optional. Override WebAuthn RP ID / origin (defaults to the request host).
# BUSINESS_BOOK_RP_ID=theartistbungalow.com
# BUSINESS_BOOK_ORIGIN=https://theartistbungalow.com
